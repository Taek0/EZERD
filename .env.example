# Local development only. pnpm setup creates .env without overwriting it.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
POSTGRES_DB=ezerd
POSTGRES_USER=ezerd
POSTGRES_PASSWORD=ezerd_local_only
POSTGRES_PORT=55432
DATABASE_URL=postgresql://ezerd:ezerd_local_only@127.0.0.1:55432/ezerd
MCP_ENABLED=false
# pnpm host:start/serve requires an approved private IPv4 CIDR. Do not use 0.0.0.0/0.
LAN_ALLOWED_CIDRS=
# Required when MCP_ENABLED=true. Use the hosting PC's private IPv4 and PORT.
# MCP_PUBLIC_URL=http://192.168.1.20:3001/mcp
MCP_LOG_DIR=.data/logs/mcp
